# SAMOS CONTROL - copie para .env e preencha. NUNCA versione o .env com valores reais.

# --- Banco (PostgreSQL) ---
# Formato Npgsql. No EasyPanel use o host interno do serviço Postgres.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=samos;Username=samos;Password=TROQUE_ESTA_SENHA
# Usados apenas pelo docker-compose.yml para criar o Postgres local
POSTGRES_DB=samos
POSTGRES_USER=samos
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# --- Aplicação ---
APP_URL=https://control.seudominio.com.br
TIMEZONE=America/Sao_Paulo
STORAGE_PATH=/data
# true = scheduler e monitoramento rodam dentro do processo web (padrão). Use apenas 1 instância.
RUN_WORKERS=true
SESSION_HOURS=12
# Dados demonstrativos. Mantenha false em produção.
SEED_DEMO_DATA=false

# --- Administrador inicial (criado se não existir nenhum usuário) ---
# Senha: mín. 10 caracteres, com letras e números. Troque após o primeiro acesso.
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=

# --- Empresa (usada nos contratos) ---
COMPANY_NAME=
COMPANY_DOCUMENT=
COMPANY_ADDRESS=

# --- Google Maps Scraper (opcional) ---
# Endpoints/campos dependem da SUA API: ajuste conforme a documentação dela (ver INTEGRATIONS.md).
GOOGLE_SCRAPER_URL=
GOOGLE_SCRAPER_API_KEY=
GOOGLE_SCRAPER_API_KEY_HEADER=
GOOGLE_SCRAPER_CREATE_PATH=
GOOGLE_SCRAPER_CREATE_BODY=
GOOGLE_SCRAPER_SEARCH_ID_PATH=
GOOGLE_SCRAPER_RESULTS_PATH=
GOOGLE_SCRAPER_ITEMS_PATH=
GOOGLE_SCRAPER_MAP_NAME=
GOOGLE_SCRAPER_MAP_PHONE=
GOOGLE_SCRAPER_MAP_ADDRESS=
GOOGLE_SCRAPER_MAP_WEBSITE=
GOOGLE_SCRAPER_MAP_PLACE_ID=
GOOGLE_SCRAPER_MAP_CITY=
GOOGLE_SCRAPER_MAP_STATE=
GOOGLE_SCRAPER_MAP_CATEGORY=
GOOGLE_SCRAPER_MAP_EMAIL=
GOOGLE_SCRAPER_SYNC_MINUTES=60

# --- Asaas (opcional) ---
# Sandbox: https://sandbox.asaas.com/api/v3  |  Produção: https://api.asaas.com/v3
ASAAS_API_URL=
ASAAS_API_KEY=
# Token que você também cadastra no webhook do Asaas (authToken). Sem ele o webhook responde 503.
ASAAS_WEBHOOK_TOKEN=

# --- Evolution API / WhatsApp (opcional) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Enviado pela Evolution no header "apikey" ou na query ?token=. Sem ele o webhook responde 503.
EVOLUTION_WEBHOOK_TOKEN=

# --- IA / Ollama (opcional) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Monitoramento ---
# Números (DDI+DDD) que recebem alertas, separados por vírgula
MONITORING_ALERT_NUMBERS=
MONITORING_ALERT_COOLDOWN_MINUTES=60

# --- E-mail SMTP (preparado; recuperação de senha gera link copiável) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
