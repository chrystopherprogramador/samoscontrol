@model ChangePasswordVm
@{ ViewData["Title"] = "Alterar senha"; }
<div class="card" style="max-width:460px"><div class="card-body">
    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
    <form method="post" asp-action="Password">
        <div class="mb-3"><label class="form-label">Senha atual</label><input asp-for="Current" type="password" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Nova senha</label><input asp-for="Password" type="password" class="form-control" required /><div class="form-text">Mínimo 10 caracteres, com letras e números.</div></div>
        <div class="mb-3"><label class="form-label">Confirmar</label><input asp-for="Confirm" type="password" class="form-control" required /></div>
        <button class="btn btn-primary" type="submit">Salvar</button>
    </form>
</div></div>
