@model List<Customer>
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex gap-2 mb-3">
    <form class="d-flex gap-2 flex-grow-1" method="get"><input name="q" value="@ViewBag.Q" class="form-control" style="max-width:300px" placeholder="Buscar nome, documento, e-mail" /><button class="btn btn-outline-primary"><i class="bi bi-search"></i></button></form>
    @if (Perms.Has(Perm.CrmEdit)) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Novo cliente</a> }
</div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Nome</th><th>Documento</th><th>E-mail</th><th>Telefone</th><th>Cidade</th><th>Status</th></tr></thead><tbody>
@foreach (var c in Model)
{ <tr><td><a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold text-decoration-none">@c.Name</a></td><td>@c.Document</td><td>@c.Email</td><td>@(c.WhatsApp ?? c.Phone)</td><td>@c.City</td><td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Ativo" : "Inativo")</span></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Nenhum cliente.</td></tr> }
</tbody></table></div></div>
