@model int
@{ Layout = "_Bare"; ViewData["Title"] = "Erro " + Model; }
<div class="card"><div class="card-body p-4 text-center">
    <h2 class="h5">@(Model == 404 ? "Página não encontrada" : Model == 403 ? "Acesso negado" : Model == 400 ? "Sessão expirada" : Model == 429 ? "Muitas tentativas" : "Ocorreu um erro")</h2>
    <p class="text-muted">@(Model == 404 ? "O endereço solicitado não existe." : Model == 400 ? "Recarregue a página de login e tente de novo (verifique se os cookies estão ativos no navegador)." : Model == 429 ? "Aguarde um minuto e tente novamente." : "Tente novamente. Se persistir, consulte os logs do sistema.")</p>
    <a class="btn btn-primary" href="/">Ir para o início</a>
</div></div>
