@model List<Notification>
@{ ViewData["Title"] = "Notificações"; var read = (HashSet<int>)ViewBag.Read; }
<form method="post" asp-action="MarkAll" class="mb-3"><button class="btn btn-sm btn-outline-primary">Marcar todas como lidas</button></form>
<div class="list-group">
@foreach (var n in Model)
{
    <a class="list-group-item list-group-item-action @(read.Contains(n.Id) ? "text-muted" : "fw-semibold")" href="@(n.Link ?? "#")">
        <div class="d-flex justify-content-between"><span><span class="badge @ViewHelpers.Badge(n.Type.ToString())">@n.Type</span> <span class="badge bg-secondary">@n.Source</span> @n.Title</span><small>@n.CreatedAt.Local()</small></div>
        @if (!string.IsNullOrEmpty(n.Message)) { <div class="small">@n.Message</div> }
    </a>
}
@if (Model.Count == 0) { <div class="list-group-item text-muted">Sem notificações.</div> }
</div>
