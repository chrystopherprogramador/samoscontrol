@model Charge
@{
    Layout = "_Bare"; ViewData["Title"] = "Pagamento"; ViewData["Width"] = "560px";
    var open = Model.Status is ChargeStatus.Pendente or ChargeStatus.Vencido;
}
<div class="card"><div class="card-body p-4">
    <h1 class="h5 mb-1">Olá, @Model.Customer?.Name</h1>
    <p class="text-muted mb-3">@(Model.ServiceName ?? Model.Description ?? "Cobrança")</p>
    <div class="d-flex justify-content-between border rounded p-3 mb-3">
        <div><div class="small text-muted">Valor</div><div class="fs-4 fw-semibold">@Model.Amount.ToString("C2")</div></div>
        <div class="text-end"><div class="small text-muted">Vencimento</div><div class="fs-5">@Model.DueDate.ToString("dd/MM/yyyy")</div></div>
    </div>
    @if (Model.Status == ChargeStatus.Pago)
    {
        <div class="alert alert-success mb-0"><i class="bi bi-patch-check"></i> Pagamento confirmado. Obrigado!</div>
    }
    else if (!open)
    {
        <div class="alert alert-warning mb-0">Esta cobrança não está mais disponível para pagamento. Em caso de dúvida, fale conosco.</div>
    }
    else
    {
        if (!string.IsNullOrWhiteSpace(Model.PixPayload))
        {
            <h2 class="h6"><i class="bi bi-qr-code"></i> Pagar com Pix</h2>
            @if (!string.IsNullOrWhiteSpace(Model.PixQrCodeBase64))
            {
                <div class="text-center mb-2"><img alt="QR Code Pix" style="width:220px;height:220px" src="data:image/png;base64,@Model.PixQrCodeBase64" /></div>
            }
            <p class="small text-muted mb-1">Pix copia e cola:</p>
            <textarea id="pix" class="form-control form-control-sm mb-2" rows="3" readonly>@Model.PixPayload</textarea>
            <button type="button" class="btn btn-success w-100 mb-3" id="copy"><i class="bi bi-clipboard"></i> Copiar código Pix</button>
        }
        @if (!string.IsNullOrWhiteSpace(Model.BoletoBarCode) || !string.IsNullOrWhiteSpace(Model.BoletoPdfUrl))
        {
            <h2 class="h6"><i class="bi bi-upc-scan"></i> Boleto</h2>
            @if (!string.IsNullOrWhiteSpace(Model.BoletoBarCode))
            {
                <p class="small text-muted mb-1">Linha digitável:</p>
                <code class="d-block mb-2 text-break">@Model.BoletoBarCode</code>
            }
            @if (!string.IsNullOrWhiteSpace(Model.BoletoPdfUrl))
            {
                <a class="btn btn-outline-secondary w-100 mb-2" href="@Model.BoletoPdfUrl" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i> Abrir boleto (PDF)</a>
            }
        }
        @if (string.IsNullOrWhiteSpace(Model.PixPayload) && !string.IsNullOrWhiteSpace(Model.InvoiceUrl))
        {
            <a class="btn btn-success w-100" href="@Model.InvoiceUrl" target="_blank" rel="noopener"><i class="bi bi-credit-card"></i> Pagar agora</a>
        }
        @if (string.IsNullOrWhiteSpace(Model.PixPayload) && string.IsNullOrWhiteSpace(Model.InvoiceUrl) && string.IsNullOrWhiteSpace(Model.BoletoBarCode))
        {
            <div class="alert alert-info mb-0">Estamos preparando seu pagamento. Atualize esta página em alguns instantes.</div>
        }
        <p class="small text-muted mt-3 mb-0">Após o pagamento a confirmação é automática.</p>
    }
</div></div>
@section Scripts {
    <script>
        document.getElementById('copy')?.addEventListener('click', async function () {
            const t = document.getElementById('pix'); t.select();
            try { await navigator.clipboard.writeText(t.value); } catch (e) { document.execCommand('copy'); }
            this.innerHTML = '<i class="bi bi-check2"></i> Código copiado!';
        });
    </script>
}
