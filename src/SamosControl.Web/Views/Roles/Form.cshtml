@model RoleForm
@{ ViewData["Title"] = Model.Id == 0 ? "Novo perfil" : "Editar perfil " + Model.Name; var groups = Perm.All.GroupBy(p => p.Split('.')[0]); }
<form method="post" class="card"><div class="card-body">
    @if (Model.Id == 0) { <div class="mb-3"><label class="form-label">Nome *</label><input asp-for="Name" class="form-control" required maxlength="50" /></div> }
    <div class="mb-3"><label class="form-label">Descrição</label><input asp-for="Description" class="form-control" maxlength="200" /></div>
    @if (Model.Name == "ADMIN") { <div class="alert alert-info">O perfil ADMIN sempre mantém todas as permissões.</div> }
    <div class="row g-3">
    @foreach (var g in groups)
    {
        <div class="col-md-4 col-lg-3"><div class="border rounded p-2 h-100"><div class="fw-semibold text-uppercase small mb-1">@g.Key</div>
        @foreach (var p in g) { <div class="form-check"><input class="form-check-input" type="checkbox" name="Permissions" value="@p" id="p_@p" checked="@Model.Permissions.Contains(p)" /><label class="form-check-label small" for="p_@p">@p</label></div> }
        </div></div>
    }
    </div>
</div><div class="card-footer"><button class="btn btn-primary">Salvar</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div></form>
