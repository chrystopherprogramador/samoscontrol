@using SamosControl.Web.Controllers
@{
    ViewData["Title"] = "Configurações";
    var cat = (SettingCategory)ViewBag.Cat; var s = (SettingsService)ViewBag.Settings;
    var status = (Dictionary<string, bool>)ViewBag.Status; var models = (List<string>)ViewBag.Models;
}
<div class="row g-3">
<div class="col-lg-3"><div class="list-group">
@foreach (var c in SettingCatalog.All)
{
    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(c.Id == cat.Id ? "active" : "")" asp-action="Index" asp-route-category="@c.Id"><span><i class="bi @c.Icon"></i> @c.Title</span>
    @if (c.Id is "scraper" or "asaas" or "efi" or "evolution" or "ia" or "voz") { <span class="badge @(status[c.Id] ? "bg-success" : "bg-secondary")">@(status[c.Id] ? "Configurado" : "Não configurado")</span> }</a>
}
</div></div>
<div class="col-lg-9"><form method="post" asp-action="Save" class="card"><input type="hidden" name="category" value="@cat.Id" />
    <div class="card-header">@cat.Title</div><div class="card-body"><div class="row g-3">
    @foreach (var f in cat.Fields)
    {
        var src = s.Source(f.Key);
        <div class="@(f.Multiline ? "col-12" : "col-md-6")"><label class="form-label">@f.Label <span class="badge bg-light text-secondary border">@f.Key</span></label>
        @if (f.Secret)
        {
            <input type="password" class="form-control" name="values[@f.Key]" autocomplete="new-password" placeholder="@(s.Has(f.Key) ? SettingsService.Mask(s.Get(f.Key)) + " (deixe em branco para manter)" : "Não configurado")" />
            @if (src == "painel") { <div class="form-check"><input class="form-check-input" type="checkbox" name="clear" value="@f.Key" id="c_@f.Key" /><label class="form-check-label small" for="c_@f.Key">Remover valor salvo no painel</label></div> }
        }
        else if ((f.Key == "OLLAMA_MODEL" || f.Key == "OLLAMA_FALLBACK_MODEL") && models.Count > 0)
        {
            <select class="form-select" name="values[@f.Key]"><option value="">(padrão)</option>@foreach (var m in models) { <option value="@m" selected="@(s.Get(f.Key) == m)">@m</option> }</select>
        }
        else if (f.Multiline) { <textarea class="form-control font-monospace" rows="3" name="values[@f.Key]">@s.Get(f.Key)</textarea> }
        else { <input class="form-control" name="values[@f.Key]" value="@s.Get(f.Key)" /> }
        <div class="form-text">Origem: @src@(f.Help != null ? " · " + f.Help : "")</div></div>
    }
    </div>
    @if (cat.Id == "ia" && ViewBag.ModelsError != null) { <div class="alert alert-warning mt-3 mb-0">Não foi possível listar modelos: @ViewBag.ModelsError</div> }
    @if (cat.Id == "efi") { <div class="alert alert-info mt-3 mb-0">Sem webhook: o status dos pagamentos é consultado automaticamente a cada 30 min (e no botão "Atualizar" da cobrança). Pix exige o certificado .p12 e a chave Pix; boleto usa apenas Client_Id/Client_Secret (ative a API Cobranças na aplicação Efí). Para usar a Efí, defina o provedor ativo em "Cobrança (provedor)".</div> }
    @if (cat.Id == "asaas") { <div class="alert alert-info mt-3 mb-0">Webhook: <code>@ViewBag.AppUrl/api/webhooks/asaas</code> — configure o mesmo token no campo authToken do webhook no Asaas.</div> }
    @if (cat.Id == "evolution") { <div class="alert alert-info mt-3 mb-0">Webhook: <code>@ViewBag.AppUrl/api/webhooks/evolution?token=SEU_TOKEN</code> (ou header <code>apikey</code>).</div> }
    </div>
    <div class="card-footer"><button class="btn btn-primary">Salvar</button> <span class="text-muted small ms-2">Valores definidos por variável de ambiente são usados quando o painel está vazio. Segredos salvos nunca são exibidos.</span></div>
</form>
@if (cat.Id == "evolution")
{
    <form method="post" asp-action="ResyncWebhooks" class="card mt-3"><div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <button class="btn btn-outline-primary"><i class="bi bi-arrow-repeat"></i> Tratar webhooks de todos os números</button>
        <span class="text-muted small">Reaplica URL, token e eventos do webhook na instância da empresa e em todos os WhatsApps dos vendedores.</span>
    </div></form>
}
</div></div>
