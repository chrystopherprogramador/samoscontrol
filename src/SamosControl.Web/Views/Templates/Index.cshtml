@model List<ContractTemplate>
@{ ViewData["Title"] = "Modelos de contrato"; }
<div class="mb-3"><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Novo modelo</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Nome</th><th>Ativo</th><th>Atualizado</th><th></th></tr></thead><tbody>
@foreach (var t in Model) { <tr><td>@t.Name</td><td><span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">@(t.IsActive ? "Sim" : "Não")</span></td><td class="small">@t.UpdatedAt.Local()</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">Editar</a></td></tr> }
</tbody></table></div></div>
