@model VoiceCall
@{
    ViewData["Title"] = "Ligação #" + Model.Id;
    var events = (List<VoiceCallEvent>)ViewBag.Events;
    var live = (bool)ViewBag.Active;
}
<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="mb-0">@(Model.ContactName ?? Model.Phone)</h5>
    <span class="badge bg-primary" id="callState" data-id="@Model.Id" data-live="@live.ToString().ToLower()">@Model.State</span>
    @if (Perms.Has(Perm.VoiceCall) && live)
    {
        <form method="post" asp-action="Hangup" class="ms-auto"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-danger btn-sm"><i class="bi bi-telephone-x"></i> Encerrar</button></form>
    }
</div>
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body small">
            <div><b>Direção:</b> @Model.Direction</div>
            <div><b>Telefone:</b> @Model.Phone</div>
            <div><b>Iniciada por:</b> @(Model.StartedByName ?? "-")</div>
            <div><b>Duração:</b> @(Model.DurationSeconds > 0 ? Model.DurationSeconds + " s" : "-")</div>
            <div><b>Motivo do fim:</b> @(Model.EndReason ?? "-")</div>
            <div><b>Resultado:</b> @(Model.Outcome ?? "-")</div>
            <div><b>Turnos:</b> @Model.Turns · <b>Interrupções:</b> @Model.BargeIns</div>
            <div><b>Latência medida (fim da fala → início da resposta):</b> média @(Model.AvgResponseLatencyMs > 0 ? Model.AvgResponseLatencyMs + " ms" : "n/d"), máx. @(Model.MaxResponseLatencyMs > 0 ? Model.MaxResponseLatencyMs + " ms" : "n/d")</div>
            <div><b>Uso:</b> @Model.TtsCharacters caracteres TTS, @Model.SttSeconds s STT, @Model.LlmCalls chamadas LLM</div>
            <div><b>Custo estimado:</b> @(Model.EstimatedCost.HasValue ? Model.EstimatedCost.Value.ToString("0.0000") + " (conforme tarifas configuradas)" : "n/d (tarifas não configuradas)")</div>
            @if (!string.IsNullOrEmpty(Model.FailureDetail)) { <div class="text-danger mt-2"><b>Falha:</b> @Model.FailureDetail</div> }
        </div></div>
        <div class="card"><div class="card-body"><h6>Eventos</h6>
            <div class="small" style="max-height:340px;overflow:auto">
                @foreach (var e in events) { <div><span class="text-muted">@e.At.ToLocalTime().ToString("HH:mm:ss")</span> <b>@e.Type</b> @e.Detail</div> }
            </div></div></div>
    </div>
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-body"><h6>Resumo da ligação</h6>
            <div style="white-space:pre-wrap">@(string.IsNullOrWhiteSpace(Model.Summary) ? "Disponível ao final da ligação." : Model.Summary)</div></div></div>
        <div class="card"><div class="card-body"><h6>Transcrição</h6>
            @if (string.IsNullOrWhiteSpace(Model.Transcript)) { <div class="text-muted small">Transcrição não armazenada (VOICE_CALLS_STORE_TRANSCRIPT desativado ou ligação em andamento).</div> }
            else { <div style="white-space:pre-wrap" class="small">@Model.Transcript</div> }
        </div></div>
    </div>
</div>
@section Scripts { <script src="~/js/voice.js" asp-append-version="true"></script> }
