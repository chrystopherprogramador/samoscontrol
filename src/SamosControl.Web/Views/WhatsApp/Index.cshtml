@{
    ViewData["Title"] = "WhatsApp";
    var tabs = (List<object>)ViewBag.Tabs;
    var sellers = (List<object>)ViewBag.Sellers;
    var scope = (string)ViewBag.Scope;
    var isAll = (bool)ViewBag.IsAll;
    string P(object o, string n) => o.GetType().GetProperty(n)!.GetValue(o)?.ToString() ?? "";
}
@if (!(bool)ViewBag.Configured) { <div class="alert alert-warning">Evolution API <strong>não configurada</strong>. Veja <a asp-controller="Settings" asp-action="Index" asp-route-category="evolution">Configurações</a>. O histórico recebido continua visível.</div> }
<div class="wa" id="wa" data-scope="@scope" data-current="@ViewBag.CurrentId" data-can-send="@(((bool)ViewBag.CanSend).ToString().ToLower())" data-all="@isAll.ToString().ToLower()">
    <div class="wa-list">
        <div class="wa-tabs">
            @foreach (var t in tabs)
            {
                var key = P(t, "key"); var un = P(t, "unread");
                <a class="wa-tab @(scope == key ? "active" : "")" href="?scope=@key"><i class="bi @P(t, "icon")"></i> @P(t, "name")@if (un != "0") { <span class="badge bg-danger rounded-pill ms-1">@un</span> }</a>
            }
        </div>
        <div class="wa-list-head">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input id="waSearch" class="form-control" placeholder="Buscar nome ou telefone" autocomplete="off" />
                @if ((bool)ViewBag.CanSend) { <button type="button" class="btn btn-outline-secondary" id="waNew" title="Nova conversa"><i class="bi bi-plus-lg"></i></button> }
            </div>
            <div class="d-flex gap-2 mt-2">
                <select id="waState" class="form-select form-select-sm"><option value="open">Abertas</option><option value="resolved">Resolvidas</option></select>
                @if (isAll)
                {
                    <select id="waSellerFilter" class="form-select form-select-sm" title="Filtrar por vendedor">
                        <option value="">Vendedor…</option>
                        @foreach (var s in sellers) { <option value="@P(s, "Id")" selected="@(scope == P(s, "Id"))">@P(s, "Name")</option> }
                    </select>
                }
            </div>
        </div>
        <div id="waConvs" class="wa-convs"><div class="p-3 text-muted small">Carregando…</div></div>
    </div>
    <div class="wa-main" id="waMain">
        <div class="wa-empty" id="waEmpty"><i class="bi bi-chat-dots"></i><div>Selecione uma conversa</div></div>
        <div class="wa-chat d-none" id="waChat">
            <div class="wa-head">
                <button type="button" class="btn btn-sm d-lg-none" id="waBack"><i class="bi bi-arrow-left"></i></button>
                <span class="wa-av" id="waHeadAv"></span>
                <div class="flex-grow-1"><div class="fw-semibold" id="waHeadName"></div><div class="small text-muted" id="waHeadSub"></div></div>
                <select id="waHeadStatus" class="form-select form-select-sm d-none" title="Status do lead"></select>
                <select id="waAssign" class="form-select form-select-sm d-none" title="Atribuir a"><option value="">Fila (sem dono)</option>@foreach (var s in sellers) { <option value="@P(s, "Id")">@P(s, "Name")</option> }</select>
                <button type="button" class="btn btn-sm btn-outline-primary d-none" id="waClaim"><i class="bi bi-hand-index"></i> Assumir</button>
                <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="waRelease" title="Devolver para a fila"><i class="bi bi-box-arrow-left"></i></button>
                <button type="button" class="btn btn-sm btn-outline-success d-none" id="waResolve"><i class="bi bi-check2-circle"></i> Resolver</button>
                <span id="waHeadLinks"></span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="waSound" title="Som de notificação"><i class="bi bi-bell"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger d-none" id="waDelete" title="Apagar conversa"><i class="bi bi-trash"></i></button>
            </div>
            <div class="wa-leadinfo d-none" id="waLeadInfo"></div>
            <div class="wa-msgs" id="waMsgs"></div>
            <div class="wa-warn d-none" id="waWarn"></div>
            @if ((bool)ViewBag.CanSend)
            {
                <div class="wa-pop d-none" id="waEmojis"></div>
                <div class="wa-pop wa-tpl d-none" id="waTpls"></div>
                <form class="wa-composer" id="waForm" autocomplete="off">
                    <input type="file" id="waFile" class="d-none" />
                    <button type="button" class="btn btn-light" id="waAttach" title="Anexar"><i class="bi bi-paperclip"></i></button>
                    <button type="button" class="btn btn-light" id="waEmoji" title="Emojis"><i class="bi bi-emoji-smile"></i></button>
                    <button type="button" class="btn btn-light" id="waTpl" title="Mensagens prontas"><i class="bi bi-lightning-charge"></i></button>
                    <textarea id="waText" class="form-control" rows="1" placeholder="Digite uma mensagem (Enter envia, Shift+Enter quebra linha)" maxlength="4000"></textarea>
                    <button class="btn btn-success" id="waSend" title="Enviar"><i class="bi bi-send-fill"></i></button>
                </form>
            }
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/whatsapp-chat.js" asp-append-version="true"></script> }
